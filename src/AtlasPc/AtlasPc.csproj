<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>AtlasPc</RootNamespace>
    <AssemblyName>AtlasPc</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NeutralLanguage>fr-FR</NeutralLanguage>
    <Platforms>AnyCPU</Platforms>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>

    <Version>0.1.0</Version>
    <Product>ATLAS PC</Product>
    <Description>Inventaire local : ordinateur, fichiers, logiciels, outils, projets.</Description>
    <Company>ATLAS PC</Company>
    <Copyright>Copyright © 2026 ATLAS PC</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\Schema.sql" />
  </ItemGroup>

</Project>
