<UserControl x:Class="AtlasPc.Views.ComputerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AtlasPc.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Six cartes : identité, processeur, carte graphique, Windows, mémoire, BIOS -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:StatCard Grid.Row="0" Grid.Column="0" Margin="0,0,16,16"
                               Label="Identité" Value="{Binding IdentityValue}" Hint="{Binding IdentityHint}"
                               Icon="{StaticResource IconComputer}"
                               IconBackground="{StaticResource OkBackgroundBrush}"
                               IconForeground="{StaticResource OkForegroundBrush}" />

            <controls:StatCard Grid.Row="0" Grid.Column="1" Margin="0,0,16,16"
                               Label="Processeur" Value="{Binding CpuValue}" Hint="{Binding CpuHint}"
                               Icon="{StaticResource IconCpu}"
                               IconBackground="{StaticResource InfoBackgroundBrush}"
                               IconForeground="{StaticResource InfoForegroundBrush}" />

            <controls:StatCard Grid.Row="0" Grid.Column="2" Margin="0,0,0,16"
                               Label="Carte graphique" Value="{Binding GpuValue}" Hint="{Binding GpuHint}"
                               Icon="{StaticResource IconGpu}"
                               IconBackground="{StaticResource FamilyImageBackgroundBrush}"
                               IconForeground="{StaticResource FamilyImageForegroundBrush}" />

            <controls:StatCard Grid.Row="1" Grid.Column="0" Margin="0,0,16,0"
                               Label="Windows" Value="{Binding WindowsValue}" Hint="{Binding WindowsHint}"
                               Icon="{StaticResource IconWindows}"
                               IconBackground="{StaticResource Accent50Brush}"
                               IconForeground="{StaticResource Accent700Brush}" />

            <controls:StatCard Grid.Row="1" Grid.Column="1" Margin="0,0,16,0"
                               Label="Mémoire installée" Value="{Binding RamValue}" Hint="{Binding RamHint}"
                               Icon="{StaticResource IconMemory}"
                               IconBackground="{StaticResource WarnBackgroundBrush}"
                               IconForeground="{StaticResource WarnForegroundBrush}" />

            <controls:StatCard Grid.Row="1" Grid.Column="2"
                               Label="BIOS" Value="{Binding BiosValue}" Hint="{Binding BiosHint}"
                               Icon="{StaticResource IconBios}"
                               IconBackground="{StaticResource NeutralBackgroundBrush}"
                               IconForeground="{StaticResource FamilyBinaryForegroundBrush}" />
        </Grid>

        <TextBlock Grid.Row="1" Margin="0,12,0,12" Style="{StaticResource CaptionText}"
                   Text="{Binding DetailText}" />

        <!-- Disques et volumes -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <Grid>
                        <TextBlock Text="Disques et volumes" Style="{StaticResource PanelTitleText}" />
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionText}"
                                   Text="{Binding HeaderText}" />
                    </Grid>
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionText}"
                               Text="{Binding VolumesCaption}" />
                </StackPanel>

                <DataGrid Grid.Row="1" Style="{StaticResource DataGridBase}"
                          ItemsSource="{Binding Volumes}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Disque" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DiskText}" ToolTip="{Binding DiskHint}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Volume" Width="200" Binding="{Binding DriveText}" />
                        <DataGridTextColumn Header="Système" Width="90" Binding="{Binding FileSystemText}" />
                        <DataGridTextColumn Header="Capacité" Width="100" Binding="{Binding CapacityText}" />
                        <DataGridTextColumn Header="Libre" Width="100" Binding="{Binding FreeText}" />

                        <DataGridTemplateColumn Header="Occupation" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Grid.Column="0" Margin="0,0,10,0"
                                                     Style="{StaticResource VolumeBar}"
                                                     Value="{Binding PercentValue, Mode=OneWay}" />
                                        <TextBlock Grid.Column="1" Text="{Binding PercentText}"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource CaptionText}"
                           Text="{Binding ExclusionsText}" />
            </Grid>
        </Border>

        <!-- Note de collecte : ce qui n'a pas été lu, ou ce qui n'a pas été fait -->
        <Border Grid.Row="3" Margin="0,12,0,0" Padding="14,10" CornerRadius="6"
                Background="{StaticResource WarnBackgroundBrush}"
                Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Collecte partielle — à lire" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource WarnForegroundBrush}" />
                <TextBlock Text="{Binding NoteText}" Margin="0,3,0,0" TextWrapping="Wrap"
                           FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
        </Border>

        <!-- État vide : aucun inventaire en base -->
        <Border Grid.RowSpan="4" Background="{StaticResource PageBackgroundBrush}"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                    <TextBlock Text="{Binding EmptyTitle}" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Margin="0,8,0,0" TextAlignment="Center" Style="{StaticResource BodyText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="{Binding EmptyMessage}" />
                    <TextBlock Margin="0,12,0,0" TextAlignment="Center" Style="{StaticResource CaptionText}"
                               Text="{Binding NoteText}"
                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
