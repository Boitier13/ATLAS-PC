<UserControl x:Class="AtlasPc.Controls.StatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Style="{StaticResource CardBorder}">
        <StackPanel>
            <Border Width="36" Height="36" CornerRadius="8" HorizontalAlignment="Left"
                    Background="{Binding IconBackground, ElementName=Root}">
                <Path Data="{Binding Icon, ElementName=Root}"
                      Stroke="{Binding IconForeground, ElementName=Root}"
                      StrokeThickness="1.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stretch="Uniform" Width="18" Height="18"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <TextBlock Text="{Binding Label, ElementName=Root}"
                       Style="{StaticResource CaptionText}" Margin="0,14,0,0" />
            <TextBlock Text="{Binding Value, ElementName=Root}"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Hint, ElementName=Root}"
                       Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
        </StackPanel>
    </Border>
</UserControl>
